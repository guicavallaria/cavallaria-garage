# Senha de acesso ao sistema (mude antes de implantar)
APP_PASSWORD=cavallaria2026

# Segredo para sessões (use uma string longa e aleatória)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Caminho do Chrome/Chromium (não necessário no Railway, já definido no Dockerfile)
# CHROME_PATH=/usr/bin/chromium

# Diretório de dados persistentes (SQLite + sessão WhatsApp)
# No Railway isso é definido como /data via volume
# DATA_DIR=/data

# ---------- Painel de pátio (sincronização com o Onmotor) ----------
# Conta do Onmotor usada pelo servidor para ler Serviços → Novidades (somente leitura).
# Nunca commitar valores reais: configurar nas variáveis do serviço no Railway.
ONMOTOR_USER=
ONMOTOR_PASS=
# ONMOTOR_BASE_URL=https://cavallaria.onmotor.com.br
# PATIO_SYNC_ENABLED=true          # false desliga o job automático (botão manual continua)
# PATIO_SYNC_INTERVAL_MIN=30       # intervalo do job; janela fixa seg–sex 07:30–19:00 (America/Sao_Paulo)
# TZ=America/Sao_Paulo             # recomendado no Railway (datetime('now','localtime') do SQLite)
