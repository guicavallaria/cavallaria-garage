# Senha de acesso ao sistema (mude antes de implantar)
APP_PASSWORD=cavallaria2026

# Segredo para sessões (use uma string longa e aleatória)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Caminho do Chrome/Chromium (não necessário no Railway, já definido no Dockerfile)
# CHROME_PATH=/usr/bin/chromium

# Diretório de dados persistentes (SQLite + sessão WhatsApp)
# No Railway isso é definido como /data via volume
# DATA_DIR=/data

# ---------- Painel de pátio (sincronização com o Onmotor) ----------
# Conta do Onmotor usada pelo servidor para ler Serviços → Novidades (somente leitura).
# Nunca commitar valores reais: configurar nas variáveis do serviço no Railway.
ONMOTOR_USER=
ONMOTOR_PASS=
# Desde 18/11/2026 a Cavallaria está no Onmotor NOVO (API JSON em https://cavallaria.onmotor.com) e a
# AWDYNA continua no antigo (HTML em https://awdyna.onmotor.com.br). Ver docs/kanban-os/10-onmotor-novo.md.
# ONMOTOR_CAVALLARIA_TIPO=api      # api (padrão) | html
# ONMOTOR_AWDYNA_TIPO=html         # html (padrão) | api — trocar quando o Onmotor da AWDYNA migrar
# ONMOTOR_API_BASE_URL=https://cavallaria.onmotor.com          # Onmotor novo da Cavallaria
# ONMOTOR_AWDYNA_API_BASE_URL=https://awdyna.onmotor.com       # Onmotor novo da AWDYNA (quando migrar)
# ONMOTOR_DEVICE_CODE=             # só se o Onmotor novo pedir código de verificação (OTP) no login automático
# ONMOTOR_BASE_URL=https://cavallaria.onmotor.com.br           # sistema antigo (só vale com TIPO=html)
# PATIO_SYNC_ENABLED=true          # false desliga o job automático (botão manual continua)
# PATIO_SYNC_INTERVAL_MIN=30       # intervalo do job; janela fixa seg–sex 07:30–19:00 (America/Sao_Paulo)
# TZ=America/Sao_Paulo             # recomendado no Railway (datetime('now','localtime') do SQLite)
# PATIO_AWDYNA_ENABLED=true        # false para ler só a Cavallaria
# ONMOTOR_AWDYNA_BASE_URL=https://awdyna.onmotor.com.br   # 2ª fonte (mesmo usuário/senha)
